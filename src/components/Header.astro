---
import type { TranslateFn } from '../utils/i18n';
import type { RouteKey } from '../utils/routing';
import { link, publicAsset } from '../utils/routing';
import { LOCALES } from '../utils/locales';
import { THEMES } from '../utils/themes';

interface Props {
  lang: string;
  t: TranslateFn;
  active: RouteKey;
  langUrls: Record<string, string>;
}

const { lang, t, active, langUrls } = Astro.props;

const navItems: { key: RouteKey; label: string }[] = [
  { key: 'collection', label: t('nav.collection') },
  { key: 'forSale', label: t('nav.forSale') },
  { key: 'wishlist', label: t('nav.wishlist') },
  { key: 'about', label: t('nav.about') },
  { key: 'contact', label: t('nav.contact') },
];

const currentLangLabel = LOCALES.find((l) => l.id === lang)?.shortLabel ?? lang.toUpperCase();
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={link(lang, 'home')}>
      <img
        class="brand__mark"
        src={publicAsset('/brand/logo-mark.png')}
        alt=""
        width="52"
        height="30"
        decoding="async"
      />
      <span class="brand__text">
        <span class="brand__name">{t('nav.brand')}</span>
        <span class="brand__location">Lavaltrie, Québec</span>
      </span>
    </a>

    <button
      type="button"
      class="button nav-toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="main-nav"
    >
      {t('nav.menu')}
    </button>

    <nav class="main-nav" id="main-nav" data-main-nav aria-label={t('nav.brand')}>
      {
        navItems.map((item) => (
          <a
            class="main-nav__link"
            href={link(lang, item.key)}
            aria-current={active === item.key ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-controls">
      <!-- Sélecteur de langue -->
      <div class="picker" data-picker>
        <button
          type="button"
          class="picker__toggle"
          data-picker-toggle
          aria-haspopup="true"
          aria-expanded="false"
          aria-label={t('lang.label')}
        >
          🌐 <span>{currentLangLabel}</span>
        </button>
        <div class="picker__menu" role="menu">
          {
            LOCALES.map((locale) => (
              <a
                class={`picker__option${locale.id === lang ? ' is-active' : ''}`}
                href={langUrls[locale.id] ?? link(locale.id, 'home')}
                hreflang={locale.id}
                aria-current={locale.id === lang ? 'true' : undefined}
                role="menuitem"
              >
                {locale.label}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Sélecteur de thème -->
      <div class="picker" data-picker>
        <button
          type="button"
          class="picker__toggle"
          data-picker-toggle
          aria-haspopup="true"
          aria-expanded="false"
          aria-label={t('theme.label')}
        >
          🎨 <span data-theme-label>{t('theme.label')}</span>
        </button>
        <div class="picker__menu" role="menu">
          {
            THEMES.map((theme) => (
              <button
                type="button"
                class="picker__option"
                data-theme-option
                data-theme-id={theme.id}
                aria-pressed="false"
                role="menuitem"
              >
                {t(`theme.${theme.id}`)}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</header>

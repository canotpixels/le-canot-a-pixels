---
import type { TranslateFn } from '../utils/i18n';
import type { RouteKey } from '../utils/routing';
import { link, publicAsset } from '../utils/routing';
import { LOCALES } from '../utils/locales';

interface Props {
  lang: string;
  t: TranslateFn;
  active: RouteKey;
  langUrls: Record<string, string>;
}

const { lang, t, active, langUrls } = Astro.props;

const navItems: { key: RouteKey; label: string }[] = [
  { key: 'collection', label: t('nav.collection') },
  { key: 'wishlist', label: t('nav.wishlist') },
  { key: 'about', label: t('nav.about') },
  { key: 'contact', label: t('nav.contact') },
];

// Avec deux langues, un simple lien vers l'autre langue suffit (pas de menu).
const otherLocales = LOCALES.filter((locale) => locale.id !== lang);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={link(lang, 'home')}>
      <img
        class="brand__mark"
        src={publicAsset('/brand/logo-mark.png')}
        alt=""
        width="52"
        height="30"
        decoding="async"
      />
      <span class="brand__text">
        <span class="brand__name">{t('nav.brand')}</span>
        <span class="brand__location">Lavaltrie, Québec</span>
      </span>
    </a>

    <nav class="main-nav" id="main-nav" data-main-nav aria-label={t('nav.brand')}>
      {
        navItems.map((item) => (
          <a
            class="main-nav__link"
            href={link(lang, item.key)}
            aria-current={active === item.key ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-controls">
      {
        otherLocales.map((locale) => (
          <a
            class="icon-button lang-switch"
            href={langUrls[locale.id] ?? link(locale.id, 'home')}
            hreflang={locale.id}
            lang={locale.id}
            aria-label={t(`lang.${locale.id}`)}
          >
            {locale.shortLabel}
          </a>
        ))
      }

      <button
        type="button"
        class="icon-button theme-toggle"
        data-theme-cycle
        aria-label={t('theme.label')}
      >
        <svg
          class="theme-toggle__icon theme-toggle__icon--sun"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
          ></path>
        </svg>
        <svg
          class="theme-toggle__icon theme-toggle__icon--moon"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>

      <button
        type="button"
        class="icon-button nav-toggle"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="main-nav"
        aria-label={t('nav.menu')}
      >
        <span class="nav-toggle__bar" aria-hidden="true"></span>
        <span class="nav-toggle__bar" aria-hidden="true"></span>
        <span class="nav-toggle__bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

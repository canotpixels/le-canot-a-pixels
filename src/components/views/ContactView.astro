---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../utils/i18n';
import { siteConfig, isPlaceholder, activeContactChannels } from '../../config/site';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const channels = activeContactChannels();
const hasLocation = siteConfig.location.trim() && !isPlaceholder(siteConfig.location);
const labels: Record<string, string> = {
  facebook: t('contact.facebook'),
  messenger: t('contact.messenger'),
  email: t('contact.email'),
};
// Valeur lisible affichée sous le libellé (ex. l'adresse courriel elle-même).
const displayValue = (channel: (typeof channels)[number]): string => {
  if (channel.type === 'email') return channel.url.replace(/^mailto:/, '');
  return channel.url.replace(/^https?:\/\//, '').replace(/\/$/, '');
};
const copyLabel = t('contact.copy');
const copiedLabel = t('contact.copied');
const copyFailedLabel = t('contact.copyFailed');
const shareLabel = t('contact.share');
---

<BaseLayout lang={lang} pageId="contact" routeKey="contact">
  <div class="page">
    <div class="container" style="max-width:640px">
      <header class="page__header">
        <h1 class="page__title">{t('contact.title')}</h1>
        <p class="page__lead">{t('contact.lead')}</p>
      </header>

      {
        channels.length > 0 ? (
          <ul class="contact-list">
            {channels.map((channel) =>
              channel.type === 'email' ? (
                <li>
                  <div class="contact-card contact-card--email">
                    <a class="contact-card__link" href={channel.url}>
                      <span class="contact-card__icon" aria-hidden="true">
                        <svg
                          viewBox="0 0 24 24"
                          width="24"
                          height="24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
                          <path d="m3.5 6.5 8.5 6 8.5-6" />
                        </svg>
                      </span>
                      <span class="contact-card__body">
                        <span class="contact-card__label">{labels[channel.type]}</span>
                        <span class="contact-card__value">{displayValue(channel)}</span>
                      </span>
                    </a>
                    <div class="contact-card__actions">
                      <button
                        type="button"
                        class="contact-action"
                        data-copy-email={displayValue(channel)}
                        data-label-copy={copyLabel}
                        data-label-copied={copiedLabel}
                        data-label-failed={copyFailedLabel}
                        aria-label={copyLabel}
                        title={copyLabel}
                      >
                        <svg
                          class="contact-action__icon contact-action__icon--copy"
                          viewBox="0 0 24 24"
                          width="19"
                          height="19"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <rect x="9" y="9" width="12" height="12" rx="2.2" />
                          <path d="M5.5 15H4.7A2.2 2.2 0 0 1 2.5 12.8V4.7A2.2 2.2 0 0 1 4.7 2.5h8.1a2.2 2.2 0 0 1 2.2 2.2v.8" />
                        </svg>
                        <svg
                          class="contact-action__icon contact-action__icon--check"
                          viewBox="0 0 24 24"
                          width="19"
                          height="19"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="m4 12.5 5.5 5.5L20 7" />
                        </svg>
                        <span class="contact-action__tooltip" role="status" aria-live="polite" />
                      </button>
                      <button
                        type="button"
                        class="contact-action"
                        data-share-email={displayValue(channel)}
                        data-share-title={labels[channel.type]}
                        aria-label={shareLabel}
                        title={shareLabel}
                      >
                        <svg
                          viewBox="0 0 24 24"
                          width="19"
                          height="19"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <circle cx="18" cy="5" r="2.6" />
                          <circle cx="6" cy="12" r="2.6" />
                          <circle cx="18" cy="19" r="2.6" />
                          <path d="m8.3 10.7 7.4-4.2M8.3 13.3l7.4 4.2" />
                        </svg>
                        <span class="contact-action__tooltip" role="status" aria-live="polite" />
                      </button>
                    </div>
                  </div>
                </li>
              ) : (
                <li>
                  <a class="contact-card" href={channel.url} rel="noopener noreferrer">
                    <span class="contact-card__icon" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        width="24"
                        height="24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                      </svg>
                    </span>
                    <span class="contact-card__body">
                      <span class="contact-card__label">{labels[channel.type]}</span>
                      <span class="contact-card__value">{displayValue(channel)}</span>
                    </span>
                    <span class="contact-card__chevron" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="m9 6 6 6-6 6" />
                      </svg>
                    </span>
                  </a>
                </li>
              )
            )}
          </ul>
        ) : (
          <p class="notice">{t('contact.noChannels')}</p>
        )
      }

      {
        hasLocation && (
          <p class="contact-location">
            <span class="contact-location__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="2.6" />
              </svg>
            </span>
            <span>
              <strong>{t('contact.locationLabel')} :</strong> {siteConfig.location}
            </span>
          </p>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: var(--color-text);
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      transform 0.1s ease;
  }
  .contact-card:hover {
    border-color: var(--color-accent);
    background: var(--color-surface-hover);
    transform: translateY(-2px);
  }

  .contact-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    color: var(--color-accent);
  }

  .contact-card__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .contact-card__label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }
  .contact-card__value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .contact-card__chevron {
    margin-left: auto;
    display: inline-flex;
    color: var(--color-text-subtle);
    transition:
      transform 0.15s ease,
      color 0.15s ease;
  }
  .contact-card:hover .contact-card__chevron {
    color: var(--color-accent);
    transform: translateX(3px);
  }

  /* Carte courriel : lien principal + actions rapides (copier / partager) */
  .contact-card--email {
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-2);
    gap: var(--space-2);
  }

  .contact-card__link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex: 1;
    min-width: 0;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
    transition: background-color 0.15s ease;
  }
  .contact-card__link:hover,
  .contact-card__link:focus-visible {
    background: var(--color-surface-hover);
  }

  .contact-card__actions {
    display: flex;
    align-items: center;
    gap: var(--space-1, 4px);
    flex-shrink: 0;
  }

  .contact-action {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      transform 0.1s ease;
  }
  .contact-action:hover {
    background: color-mix(in srgb, var(--color-accent) 20%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
  }
  .contact-action:active {
    transform: scale(0.94);
  }
  .contact-action:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .contact-action[hidden] {
    display: none;
  }

  .contact-action__icon--check {
    position: absolute;
    opacity: 0;
    transform: scale(0.5);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }
  .contact-action__icon--copy {
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }
  .contact-action.is-success {
    background: color-mix(in srgb, #22c55e 18%, transparent);
    border-color: color-mix(in srgb, #22c55e 40%, transparent);
    color: #16a34a;
  }
  .contact-action.is-success .contact-action__icon--copy {
    opacity: 0;
    transform: scale(0.5);
  }
  .contact-action.is-success .contact-action__icon--check {
    opacity: 1;
    transform: scale(1);
  }
  .contact-action.is-error {
    background: color-mix(in srgb, #ef4444 16%, transparent);
    border-color: color-mix(in srgb, #ef4444 40%, transparent);
    color: #dc2626;
  }

  .contact-action__tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    padding: 5px 10px;
    border-radius: var(--radius-sm, 6px);
    background: var(--color-text);
    color: var(--color-surface);
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }
  .contact-action__tooltip:not(:empty) {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (max-width: 480px) {
    .contact-card--email {
      flex-wrap: wrap;
    }
    .contact-card__link {
      min-width: 100%;
    }
    .contact-card__actions {
      margin-left: auto;
    }
  }

  .contact-location {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    color: var(--color-text-muted);
  }
  .contact-location__icon {
    display: inline-flex;
    color: var(--color-accent);
  }
  .contact-location strong {
    color: var(--color-text);
  }
</style>

<script>
  const actionTimeouts = new WeakMap<HTMLButtonElement, number>();

  function resetAction(button: HTMLButtonElement) {
    button.classList.remove('is-success', 'is-error');
    const tooltip = button.querySelector<HTMLElement>('.contact-action__tooltip');
    if (tooltip) tooltip.textContent = '';
  }

  function flashTooltip(button: HTMLButtonElement, message: string, state: 'success' | 'error') {
    const tooltip = button.querySelector<HTMLElement>('.contact-action__tooltip');
    if (tooltip) tooltip.textContent = message;
    button.classList.add(state === 'success' ? 'is-success' : 'is-error');
    const existing = actionTimeouts.get(button);
    if (existing) window.clearTimeout(existing);
    actionTimeouts.set(
      button,
      window.setTimeout(() => resetAction(button), 1800)
    );
  }

  async function copyToClipboard(text: string): Promise<boolean> {
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch {
      // fall through to legacy fallback
    }
    try {
      const helper = document.createElement('textarea');
      helper.value = text;
      helper.style.position = 'fixed';
      helper.style.opacity = '0';
      document.body.appendChild(helper);
      helper.select();
      const ok = document.execCommand('copy');
      helper.remove();
      return ok;
    } catch {
      return false;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
    button.addEventListener('click', async () => {
      const email = button.dataset.copyEmail ?? '';
      const ok = await copyToClipboard(email);
      flashTooltip(
        button,
        ok
          ? (button.dataset.labelCopied ?? 'Copied!')
          : (button.dataset.labelFailed ?? 'Copy failed'),
        ok ? 'success' : 'error'
      );
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-share-email]').forEach((button) => {
    const canShare = typeof navigator.share === 'function';
    if (!canShare) {
      button.hidden = true;
      return;
    }
    button.addEventListener('click', async () => {
      const email = button.dataset.shareEmail ?? '';
      const title = button.dataset.shareTitle ?? '';
      try {
        await navigator.share({ title, text: email });
      } catch {
        // Annulé par l'utilisateur ou non supporté : on ignore silencieusement.
      }
    });
  });
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../utils/i18n';
import { link } from '../../utils/routing';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Lien Wikipédia vers la légende de la chasse-galerie, dans la langue de la page.
const legendUrl =
  lang === 'en'
    ? 'https://en.wikipedia.org/wiki/Chasse-galerie'
    : 'https://fr.wikipedia.org/wiki/Chasse-galerie';
const legendLink = `<a href="${legendUrl}" target="_blank" rel="noopener noreferrer">${t('about.legendLinkLabel')}</a>`;
const storyHtml = t('about.storyBody', { legendLink });
---

<BaseLayout lang={lang} pageId="about" routeKey="about">
  <div class="page">
    <div class="container" style="max-width:720px">
      <header class="page__header">
        <h1 class="page__title">{t('about.title')}</h1>
        <p class="page__lead">{t('about.lead')}</p>
      </header>

      <h2 class="section__title">{t('about.storyTitle')}</h2>
      <p set:html={storyHtml} />

      <h2 class="section__title">{t('about.seekTitle')}</h2>
      <p>{t('about.seekBody')}</p>
      <p>
        <a class="button" href={link(lang, 'wishlist')}>{t('about.seekCta')}</a>
      </p>

      <h2 class="section__title">{t('about.collectionTitle')}</h2>
      <p>{t('about.collectionBody')}</p>
      <p>
        <a class="button" href={link(lang, 'collection')}>{t('about.collectionCta')}</a>
      </p>

      <h2 class="section__title">{t('about.sourceTitle')}</h2>
      <p>{t('about.sourceBody')}</p>

      <h2 class="section__title">{t('about.disclaimerTitle')}</h2>
      <p class="notice">{t('about.disclaimerBody')}</p>
    </div>
  </div>
</BaseLayout>

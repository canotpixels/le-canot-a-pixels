---
import type { Game } from '../data/games';
import type { TranslateFn } from '../utils/i18n';
import { link } from '../utils/routing';
import GameImage from './GameImage.astro';
import ConsoleBadge from './ConsoleBadge.astro';
import CompletenessBadge from './CompletenessBadge.astro';

interface Props {
  game: Game;
  lang: string;
  t: TranslateFn;
  eager?: boolean;
}

const { game, lang, t, eager = false } = Astro.props;

const href = link(lang, 'games', game.slug);
// Boutique orientée collectionneur : aucun prix affiché sur les cartes.
const showReferenceNote = game.primaryImage.source !== 'personal';
---

<article class="card">
  <div class="card__media">
    <a href={href} tabindex="-1" aria-hidden="true">
      <GameImage image={game.primaryImage} class="card__img" loading={eager ? 'eager' : 'lazy'} />
    </a>
    {showReferenceNote && <p class="card__ref-note">{t('card.referenceNote')}</p>}
  </div>

  <div class="card__body">
    <h3 class="card__title">
      <a href={href} aria-label={t('card.viewDetail', { title: game.title })}>{game.title}</a>
    </h3>
    <div class="card__tags">
      <ConsoleBadge console={game.console} />
      {
        game.completeness !== 'unknown' && (
          <CompletenessBadge
            completeness={game.completeness}
            label={t(`completeness.${game.completeness}`)}
          />
        )
      }
      {game.region && <span class="card__region">{game.region}</span>}
    </div>
  </div>
</article>

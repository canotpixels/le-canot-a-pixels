---
import CatalogView from '../components/views/CatalogView.astro';
import { SELL_ALL_COLLECTION } from '../data/games';
import { link } from '../utils/routing';

// Toute la collection est à vendre : cette page serait un doublon de « À vendre ».
if (SELL_ALL_COLLECTION) return Astro.redirect(link('fr', 'forSale'));
---

<CatalogView
  lang="fr"
  status="collection"
  routeKey="collection"
  pageId="collection"
  titleKey="catalog.collectionTitle"
  leadKey="catalog.collectionLead"
/>

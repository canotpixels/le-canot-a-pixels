{
  "name": "poc-collection-xbox",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run data:build && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "data:import": "tsx scripts/import.ts",
    "covers:sync": "tsx scripts/covers-sync.ts",
    "data:build": "tsx scripts/build-data.ts",
    "build:e2e": "tsx scripts/build-data.ts --fixture && astro build",
    "validate": "npm run typecheck && npm run lint && npm run data:validate",
    "data:validate": "tsx scripts/build-data.ts --validate-only",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^2.1.8"
  }
}

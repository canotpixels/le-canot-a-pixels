# =============================================================================
# Exemple de configuration d'environnement — COPIER vers .env
#   cp .env.example .env
#
# Le fichier .env réel est ignoré par git (voir .gitignore).
# Aucune clé ne doit JAMAIS être committée ni exposée dans le bundle client.
# Ces variables ne sont lues QUE par les scripts Node (import / covers:sync),
# jamais par le code du site.
# =============================================================================

# URL publique finale du site (pour les canoniques, le sitemap, Open Graph).
# Production GitHub Pages : https://otisdave.github.io (origine seulement).
SITE_URL=https://otisdave.github.io

# Chemin de base. '/' pour Cloudflare Pages ou un domaine racine.
# Pour GitHub Pages de type dépôt de projet : '/canot-pixels-collection/'
BASE_PATH=/canot-pixels-collection/

# -----------------------------------------------------------------------------
# Fournisseur de pochettes génériques (utilisé UNIQUEMENT par covers:sync)
#   - pricecharting : chaîne PriceCharting → IGDB → Libretro (DÉFAUT). AUCUNE
#                     clé requise. Correspondance EXACTE par id produit du CSV
#                     (photo de la fiche PriceCharting, ~100 % de couverture).
#                     Si les identifiants IGDB ci-dessous sont renseignés,
#                     IGDB est inséré comme 2e maillon de la chaîne.
#   - libretro      : jaquettes libretro-thumbnails seules, AUCUNE clé.
#                     Bonne couverture Xbox d'origine, très partielle Xbox 360.
#   - igdb          : IGDB via Twitch (identifiants requis). IGDB + Libretro.
#   - null          : aucun appel réseau.
# -----------------------------------------------------------------------------
COVER_PROVIDER=pricecharting

# Identifiants IGDB (application Twitch gratuite : https://dev.twitch.tv/console)
# Facultatifs : améliorent la chaîne par défaut et requis si COVER_PROVIDER=igdb.
# Utilisés uniquement par covers:sync.
COVER_API_CLIENT_ID=
COVER_API_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# PUBLIC_SELL_ALL_COLLECTION : lue par le SITE (au build), contrairement aux
# autres variables de ce fichier (préfixe PUBLIC_ requis par Astro pour être
# lue via import.meta.env). Si 'true', l'onglet « à vendre » affiche aussi
# tous les jeux de la collection (en plus de ceux au statut for-sale), sans
# changer leur statut individuel. Utile si toute la collection est
# potentiellement à vendre. Défaut : false (seuls les jeux marqués for-sale
# apparaissent).
# -----------------------------------------------------------------------------
PUBLIC_SELL_ALL_COLLECTION=false
